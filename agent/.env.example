# Copier vers .env puis renseigner — https://console.groq.com/keys (gratuit)
GROQ_API_KEY=
# Optionnel : modèles open-source alternatifs
# OPENROUTER_API_KEY=
# OLLAMA_URL=http://localhost:11434

# --- Service ---
AGENT_TOKEN=dev-agent-token
SITE_URL=https://buzzafrique.vercel.app
RUN_INTERVAL_MINUTES=30

# --- Catalogue (bibliothèque : rien n'est jamais supprimé) ---
AUTO_PUBLISH=true
MAX_ARTICLES_PER_CYCLE=2
# 0 = aucun plafond ; > 0 = arrêt de la création au-delà de N articles (sans suppression)
CATALOG_MAX=0

# --- Persistance ---
# Sur un hébergeur à disque persistant : DB_PATH=/var/data/seo-boss.db
# DB_PATH=./data/seo-boss.db

# --- IndexNow (Bing, Yandex, Naver, Seznam — Google ne participe pas) ---
INDEXNOW_ENABLED=true
INDEXNOW_KEY=0f8c1a2e4b6d4f0aa1b2c3d4e5f60718
